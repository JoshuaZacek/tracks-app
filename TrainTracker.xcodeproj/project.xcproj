{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "TrainTracker", "target-membership": [ "TrainTracker" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "TrainTracker", "TrainTrackerWidgetsExtension" ] },
    { "kind": "folder", "path": "TrainTrackerTests", "target-membership": [ "TrainTrackerTests" ] },
    { "kind": "folder", "path": "TrainTrackerUITests", "target-membership": [ "TrainTrackerUITests" ] },
    {
      "kind": "folder",
      "path": "TrainTrackerWidgets",
      "target-membership": [
        "TrainTrackerWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "TrainTrackerWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "TrainTrackerWidgetsExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "TrainTrackerWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/TrainTracker.app", "id": "AEFC5CE330990132005CB14E", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TrainTrackerTests.xctest", "id": "AEFC5CF030990133005CB14E", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/TrainTrackerUITests.xctest", "id": "AEFC5CFA30990133005CB14E", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/TrainTrackerWidgetsExtension.appex", "id": "AEFC5E3F309A038A005CB14E", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "TrainTracker/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "TrainTracker",
      "id": "AEFC5CE230990132005CB14E",
      "product": "Products/TrainTracker.app",
      "product-type": "application",
      "dependencies": [
        "TrainTrackerWidgetsExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]": "Config/TrainTracker.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "TYKCDFU4XA",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "tracks",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "tracks connects to the tracks server on your Mac over the local network.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Your location is sent to the tracks server only to find the stations near you, and isn't stored.",
        "INFOPLIST_KEY_NSSupportsLiveActivities": "YES",
        "INFOPLIST_KEY_NSSupportsLiveActivitiesFrequentUpdates": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.joshuazacek.TrainTracker",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "TRACKS_BASE_URL": "https://tracks-api.joshuazacek.com",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). -->
	<!-- The tracks server to use; set per SDK by the TRACKS_BASE_URL build setting. -->
	<key>TracksBaseURL</key>
	<string>$(TRACKS_BASE_URL)</string>
	<!-- Plain HTTP to a development server on the local network (*.local), e.g. via the tracksBaseURL override; the deployed server is HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TrainTracker connects to the tracks server on your Mac over the local network.</string>
</dict>
</plist>
